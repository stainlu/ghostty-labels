<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>GHOSTTY_LABEL_POSITION</key>
		<string>top-right</string>
	</dict>
	<key>Label</key>
	<string>com.stainlu.ghostty-labels</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/Applications/Ghostty Labels.app/Contents/MacOS/ghostty-labels</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/ghostty-labels.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/ghostty-labels.log</string>
</dict>
</plist>
